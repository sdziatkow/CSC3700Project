@baseUrl = http://localhost:3000/api

### 1. GET all courses where each course has an array of its prerequisite IDs -- expect 200
GET {{baseUrl}}/courses

### 2. GET one course by ID with an array of its prerequisite IDs -- expect 200 and a single course object.
GET {{baseUrl}}/courses/1

### 3. GET a course object that does not exist -- expect 404 course not found.
GET {{baseUrl}}/courses/notAnID

### 4. A route that does not exist -- expect 404 Route not found.
GET {{baseUrl}}/noRoute

### 5. POST -- create a new course -- expect 201 with the new course including its ID and prerequisite IDs in an Array.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC5000",
  "title": "Final programming",
  "credits": 4,
  "description": "Final class",
  "prerequisites": [8, 9, 10]
}

### 6. POST -- create an invalid course -- expect 400 Given course information is invalid.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC5000",
  "title": "test course",
  "credits": 4,
  "description": "test",
  "prerequisites": [0]
}

### 7. PUT -- update course with specified ID.
PUT {{baseUrl}}/courses/23
Content-Type: application/json

{
  "number": "CSC5200",
  "title": "test course",
  "credits": 4,
  "description": "test test",
  "prerequisites": [9, 10]
}

### 8. DELETE -- remove course with specified ID.
DELETE {{baseUrl}}/courses/23