@baseUrl = http://localhost:3000/api

### 1. GET all courses where each course has an array of its prerequisite IDs -- expect 200 and all course objects.
GET {{baseUrl}}/courses

### 2. GET one course by ID with an array of its prerequisite IDs -- expect 200 and a single course object.
GET {{baseUrl}}/courses/1

### 3. GET a course object that does not exist -- expect 404 course not found.
GET {{baseUrl}}/courses/notAnID

### 4. GET a route that does not exist -- expect 404 Route not found.
GET {{baseUrl}}/noRoute

### 5. POST a new course -- expect 201 with the new course including its ID and prerequisite IDs in an Array.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC5000",
  "title": "Final programming",
  "credits": 4,
  "description": "Final class",
  "prerequisites": [8, 9, 10]
}

### 6. POST -- create an invalid course -- expect 400 Course prerequisites must exist.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC5000",
  "title": "test course",
  "credits": 4,
  "description": "test",
  "prerequisites": [1000]
}

### 7. POST -- create an invalid course -- expect 400 Course number must begin with 'CSC'.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CS5000",
  "title": "test course",
  "credits": 4,
  "description": "test",
  "prerequisites": []
}

### 8. POST -- create an invalid course -- expect 400 Course number must end with an integer.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC",
  "title": "test course",
  "credits": 4,
  "description": "test",
  "prerequisites": []
}

### 9. POST -- create an invalid course -- expect 400 Course number must end with an integer less than ten-thousand.
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC10324",
  "title": "test course",
  "credits": 4,
  "description": "test",
  "prerequisites": []
}

### 10. PUT -- update course with specified ID.
PUT {{baseUrl}}/courses/26
Content-Type: application/json

{
  "number": "CSC5200",
  "title": "test course",
  "credits": 4,
  "description": "test test",
  "prerequisites": [9, 10]
}

### 11. PUT -- update course that does not exist -- expect 404 Course Not Found. Given ID: 9999.
PUT {{baseUrl}}/courses/9999
Content-Type: application/json

{
  "number": "CSC9999",
  "title": "DNE",
  "credits": 0,
  "description": "This course does not exist",
  "prerequisites": [9, 10]
}

### 12. DELETE -- remove course with specified ID -- expect 200 and deleted course object with prerequisites.
DELETE {{baseUrl}}/courses/26

### 13. GET array of completed course IDs -- expect 200 and completions array.
GET {{baseUrl}}/completions

### 14. PUT -- update completions set -- expect 200 and new completions array.
PUT {{baseUrl}}/completions
Content-Type: application/json

{
  "completed": [1, 2]
}

### 15. PUT -- update completions set with non-existing prereq -- expect 400 Given completion information is invalid.
PUT {{baseUrl}}/completions
Content-Type: application/json

{
  "completed": [1000]
}